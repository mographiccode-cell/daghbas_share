{
  "description": "AI Agent Security Guard hooks for Codex prompts and local tool calls.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/agent_guard_hook.py",
            "command_windows": "py -3 .codex\\hooks\\agent_guard_hook.py",
            "timeout": 180,
            "statusMessage": "Checking prompt with AI Agent Security Guard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/agent_guard_hook.py",
            "command_windows": "py -3 .codex\\hooks\\agent_guard_hook.py",
            "timeout": 180,
            "statusMessage": "Checking tool action with AI Agent Security Guard"
          }
        ]
      }
    ]
  }
}
