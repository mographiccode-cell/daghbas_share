{
  "description": "AI Agent Security Guard hooks for Codex prompts, tool calls, and returned external content.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/agent_guard_hook.py",
            "timeout": 180,
            "statusMessage": "Checking prompt with AI Agent Security Guard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/agent_guard_hook.py",
            "timeout": 180,
            "statusMessage": "Checking tool action with AI Agent Security Guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/agent_guard_hook.py",
            "timeout": 180,
            "statusMessage": "Checking tool output with AI Agent Security Guard"
          }
        ]
      }
    ]
  }
}
