# Backend
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440
AGENT_GUARD_DB_URL=sqlite:///./data/agent_guard.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional local semantic analysis
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Codex hook bridge (set locally; never commit real token)
AGENT_GUARD_URL=http://127.0.0.1:8000
AGENT_GUARD_TOKEN=
AGENT_GUARD_APPROVAL_TIMEOUT=120
AGENT_GUARD_FAIL_CLOSED=true
